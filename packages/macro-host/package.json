{
	"name": "@stateful-mcp/macro-host",
	"version": "0.1.0",
	"description": "Bun-hosted application lifecycle for Macro workspaces",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": ["dist"],
	"scripts": {
		"build": "bun build ./src/index.ts --outfile=dist/index.js --target=bun --format=esm --packages=external && tsc --emitDeclarationOnly --declaration --outDir dist",
		"check": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@stateful-mcp/core": "workspace:^",
		"@stateful-mcp/macro": "workspace:^"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/node": "^20",
		"typescript": "^5"
	}
}
