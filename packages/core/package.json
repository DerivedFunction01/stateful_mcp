{
	"name": "@stateful-mcp/core",
	"version": "0.5.0",
	"description": "Stateful framework core (transport and LLM-agnostic)",
	"keywords": [
		"stateful",
		"middleware",
		"filter",
		"version-control",
		"vcs",
		"object",
		"event",
		"form",
		"dictionary",
		"dag"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "bun build ./src/index.ts --outfile dist/index.js --target bun --format esm --external '*.node' && tsc --emitDeclarationOnly --declaration --outDir dist",
		"manual-test:build": "bun manual-test/build.ts",
		"manual-test:serve": "bun manual-test/serve.ts",
		"check": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@duckdb/node-api": "^1.5.5-r.1",
		"@sqlite.org/sqlite-wasm": "latest",
		"ajv": "^8.20.0",
		"pg": "^8.22.0",
		"zod": "^3.22.4"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/node": "^20",
		"@types/pg": "^8.20.0",
		"typescript": "^5"
	},
	"optionalDependencies": {
		"duckdb": "^1.4.4"
	}
}
