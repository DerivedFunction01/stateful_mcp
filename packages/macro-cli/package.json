{
	"name": "@stateful-mcp/macro-cli",
	"version": "0.1.0",
	"description": "Generic terminal UI for the Stateful macro workspace",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"macro-cli": "./dist/index.js"
	},
	"files": ["dist"],
	"scripts": {
		"build": "bun build ./src/index.ts --outfile=dist/index.js --target=bun --format=esm --packages=external && tsc --emitDeclarationOnly --declaration --outDir dist",
		"check": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@stateful-mcp/macro": "workspace:^",
		"@opentui/core": "latest",
		"@opentui/keymap": "latest",
		"@opentui/react": "latest",
		"react": "^19.2.0"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/node": "^20",
		"@types/react": "^19.2.0",
		"typescript": "^5"
	}
}
