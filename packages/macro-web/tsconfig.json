{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"baseUrl": ".",
		"paths": {
			"@stateful-mcp/macro": ["../macro/src/index.ts"],
			"@stateful-mcp/macro/*": ["../macro/src/*"],
			"@stateful-mcp/macro-protocol": ["../macro-protocol/src/index.ts"],
			"@stateful-mcp/macro-host": ["../macro-host/src/index.ts"],
			"@stateful-mcp/core": ["../core/src/index.ts"],
			"@stateful-mcp/core/*": ["../core/src/*"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx"],
	"exclude": ["node_modules", "dist"]
}
