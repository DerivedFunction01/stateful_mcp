{
	"name": "@stateful-mcp/cli",
	"version": "0.5.0",
	"description": "Administrative CLI tool for Stateful framework",
	"type": "module",
	"bin": {
		"clinical": "./dist/index.js"
	},
	"scripts": {
		"build": "bun build ./src/index.ts --outfile dist/index.js --target bun --format esm --external '*.node'",
		"start": "bun run ./src/index.ts"
	},
	"dependencies": {
		"@duckdb/node-api": "^1.5.4-r.1",
		"@stateful-mcp/clinical": "workspace:^",
		"@stateful-mcp/core": "workspace:^",
		"@sqlite.org/sqlite-wasm": "latest"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/node": "^20",
		"typescript": "^5"
	}
}