{
	"name": "@stateful-mcp/cli2",
	"version": "0.5.0",
	"description": "Administrative CLI tool for Stateful framework",
	"keywords": [
		"cli",
		"admin",
		"stateful",
		"mcp",
		"gc",
		"inspect",
		"migrate"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "bun build ./src/index.ts --outfile dist/index.js --target bun --format esm --external '*.node' --external 'ink' --external 'react' --external 'react-devtools-core' --external 'react-reconciler' --external 'scheduler'",
		"check": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@stateful-mcp/clinical": "workspace:^",
		"@stateful-mcp/core": "workspace:^",
		"ink": "^7.1.1",
		"react": "^19.2.8"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/node": "^20",
		"@types/react": "^19.2.18",
		"typescript": "^5"
	}
}
